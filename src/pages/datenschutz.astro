---
import { getEntry, render } from "astro:content";
import ChevronLeft from "../assets/chevron-left.svg";
import PageMain from "../components/PageMain.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import Layout from "../layouts/Layout.astro";

const gdpr = await getEntry("privacy-policy", "datenschutz");
if (!gdpr) {
	throw new Error("Missing content entry: privacy-policy/datenschutz");
}

const { Content } = await render(gdpr);
---

<Layout title={gdpr.data.title}>
	<SiteNav>
		<a
			href="/"
			class="container mx-auto flex items-center gap-1.5 p-4"
		>
			<ChevronLeft class="size-4 shrink-0" aria-hidden="true" />
			Zur Startseite
		</a>
	</SiteNav>
	<PageMain>
		<h1>{gdpr.data.title}</h1>
		<Content />
	</PageMain>
	<SiteFooter />
</Layout>
