---
import { getEntry, render } from "astro:content";
import BasicSiteNav from "../components/BasicSiteNav.astro";
import PageMain from "../components/PageMain.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";

const gdpr = await getEntry("privacy-policy", "datenschutz");
if (!gdpr) {
	throw new Error("Missing content entry: privacy-policy/datenschutz");
}

const { Content } = await render(gdpr);
---

<Layout
	title={`${gdpr.data.title} | Bar Uno`}
	description="Datenschutzerklärung der Bar Uno München — Informationen zur Verarbeitung personenbezogener Daten."
>
	<BasicSiteNav/>
	<PageMain>
		<h1>{gdpr.data.title}</h1>
		<Content />
	</PageMain>
	<SiteFooter />
</Layout>
