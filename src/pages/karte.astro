---
import { getCollection } from "astro:content";
import ChevronLeft from "../assets/chevron-left.svg";
import ChevronUp from "../assets/chevron-up.svg";
import AllergenLinks from "../components/AllergenLinks.astro";
import PageMain from "../components/PageMain.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import Layout from "../layouts/Layout.astro";

const karteSections = (await getCollection("menu")).sort(
	(a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

function formatPrice(price: string) {
	return /^\d/.test(price) ? `${price} €` : price;
}
---

<Layout
	title="Speise- & Getränkekarte | Bar Uno München"
	description="Abendkarte der Bar Uno in München: Speisen, Cocktails, Weine, Biere und mehr."
>
	<SiteNav>
		<div
			class="container mx-auto flex items-center justify-between gap-4 p-4"
		>
			<a href="/" class="flex items-center gap-1.5">
				<ChevronLeft class="size-4 shrink-0" aria-hidden="true" />
				Zur Startseite
			</a>
			<a
				href="#top"
				data-to-top
				class="invisible flex items-center gap-1.5 opacity-0 transition-opacity data-[scrolled]:visible data-[scrolled]:opacity-100"
			>
				Nach oben
				<ChevronUp class="size-4 shrink-0" aria-hidden="true" />
			</a>
		</div>
	</SiteNav>
	<script is:inline>
		const toTopLink = document.querySelector("[data-to-top]");
		const toTopThreshold = 200;

		const updateToTopLink = () => {
			toTopLink?.toggleAttribute(
				"data-scrolled",
				window.scrollY >= toTopThreshold,
			);
		};

		updateToTopLink();
		document.addEventListener("scroll", updateToTopLink, { passive: true });
	</script>
	<PageMain>
		<h1>Karte</h1>
		<nav aria-label="Kartenabschnitte">
			<ul
				class="flex flex-wrap gap-x-2 gap-y-1 [&>li:not(:last-child)::after]:ms-2 [&>li:not(:last-child)::after]:content-['·']"
			>
				{
					karteSections.map((karte) => (
						<li>
							<a href={`#${karte.id}`}>{karte.data.title}</a>
						</li>
					))
				}
			</ul>
		</nav>
		{
			karteSections.map((karte) => (
				<section id={karte.id} class="mt-8 scroll-mt-24">
					<h2>{karte.data.title}</h2>
					{karte.data.comment && (
						<p class="italic text-muted">{karte.data.comment}</p>
					)}
					{karte.data.sections.map((section) => (
						<div class="mt-6">
							{section.title && <h3>{section.title}</h3>}
							{section.comment && (
								<p class="italic text-muted">{section.comment}</p>
							)}
							<ul>
								{section.items.map((item) => (
									<li class="mb-4">
										<strong>{item.name}</strong>
										{item.allergens && (
											<AllergenLinks allergens={item.allergens} />
										)}{" "}
										— {formatPrice(item.price)}
										{item.comment && (
											<p class="m-0 italic text-muted">{item.comment}</p>
										)}
									</li>
								))}
							</ul>
							{section.note && (
								<p class="text-sm text-muted">{section.note}</p>
							)}
						</div>
					))}
					{karte.data.note && (
						<p class="text-sm text-muted">{karte.data.note}</p>
					)}
				</section>
			))
		}
	</PageMain>
	<SiteFooter />
</Layout>
