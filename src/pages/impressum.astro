---
import { getEntry, render } from "astro:content";
import BasicSiteNav from "../components/BasicSiteNav.astro";
import PageMain from "../components/PageMain.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";

const siteNotice = await getEntry("site-notice", "impressum");
if (!siteNotice) {
	throw new Error("Missing content entry: site-notice/impressum");
}

const { Content } = await render(siteNotice);
---

<Layout
	title={`${siteNotice.data.title} | Bar Uno`}
	description="Impressum und Anbieterkennzeichnung der Bar Uno, Ludwigstraße 11, 80539 München."
>
	<BasicSiteNav/>
	<PageMain>
		<h1>{siteNotice.data.title}</h1>
		<Content />
	</PageMain>
	<SiteFooter />
</Layout>
