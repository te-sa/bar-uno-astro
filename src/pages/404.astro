---
import PageMain from "../components/PageMain.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Layout from "../layouts/Layout.astro";
import BasicSiteNav from "../components/BasicSiteNav.astro";
---

<Layout
	title="Seite nicht gefunden | Bar Uno"
	noindex
>
	<BasicSiteNav/>
	<PageMain>
		<h1>Seite nicht gefunden</h1>
		<p>	Diese Seite gibt es nicht mehr oder der Link enthält einen Tippfehler. Hier geht es weiter:</p>
		<div class="mt-8 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
			<a
				href="/"
				class="inline-flex items-center justify-between gap-4 border-2 border-black bg-white px-5 py-4 font-semibold shadow-[4px_4px_0_0_#000] transition-colors hover:bg-black hover:text-white hover:no-underline"
			>
				Zur Startseite
				<span class="shrink-0 text-2xl" aria-hidden="true">→</span>
			</a>
			<a
				href="/karte/"
				class="inline-flex items-center justify-between gap-4 border-2 border-black bg-black px-5 py-4 font-semibold text-white shadow-[4px_4px_0_0_#000] transition-colors hover:bg-white hover:text-black hover:no-underline"
			>
				Zur Abendkarte
				<span class="shrink-0 text-2xl" aria-hidden="true">→</span>
			</a>
		</div>
	</PageMain>
	<SiteFooter />
</Layout>
