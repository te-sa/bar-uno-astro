---
import type { HeroBannerData } from "../utils/heroBanner";
import { formatBerlinDate } from "../utils/heroBanner";

type Props = HeroBannerData;

const { text, startDate, endDate } = Astro.props;
---

<div
	data-hero-banner
	data-start={startDate ? formatBerlinDate(startDate) : undefined}
	data-end={endDate ? formatBerlinDate(endDate) : undefined}
	role="status"
	aria-live="polite"
	class="absolute inset-x-0 top-0 z-10 flex items-baseline gap-2.5 px-4 py-2.5 text-sm font-semibold sm:gap-3 sm:text-base bg-foreground text-background shadow-[0_2px_8px_-2px_var(--color-muted),0_8px_24px_-4px_var(--color-muted),0_20px_48px_-8px_var(--color-muted)]"
>
	<p class="m-0 min-w-0 max-w-prose line-clamp-2 text-left leading-snug">{text}</p>
</div>

<script is:inline>
	(function () {
		const banner = document.querySelector("[data-hero-banner]");
		if (!(banner instanceof HTMLElement)) {
			return;
		}

		const timezone = "Europe/Berlin";

		function berlinDate(date) {
			return new Intl.DateTimeFormat("en-CA", {
				timeZone: timezone,
				year: "numeric",
				month: "2-digit",
				day: "2-digit",
			}).format(date);
		}

		function isVisible() {
			const today = berlinDate(new Date());
			const start = banner.dataset.start;
			const end = banner.dataset.end;

			if (start && today < start) {
				return false;
			}

			if (end && today > end) {
				return false;
			}

			return true;
		}

		function updateVisibility() {
			banner.hidden = !isVisible();
		}

		updateVisibility();
		window.setInterval(updateVisibility, 60_000);
	})();
</script>
