---
import { Image } from "astro:assets";
import HeroImage from "../assets/bar-front.webp";
import UnoLogo from "../assets/uno-logo.svg";

const year = new Date().getFullYear();
---

<header class="relative">
  <Image
    src={HeroImage}
    alt="Bar Uno Außenansicht"
    class="w-full h-auto block"
  />
  <h1>
    <span class="sr-only">Bar Uno</span><UnoLogo
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-1/3"
      aria-hidden="true"
    />
  </h1>
</header>
<nav
  class="sticky -top-0.5 z-10 bg-white shadow-[0_4px_12px_-4px_rgb(0_0_0/0.12)]"
>
  <ul
    class="flex justify-center items-center gap-2 py-4 border-y-2 border-black [&>li:not(:last-child)::after]:ms-2 [&>li:not(:last-child)::after]:content-['·']"
  >
    <li><a href="#zu-uns">Zu uns</a></li>
    <li><a href="#specials">Specials</a></li>
    <li><a href="#karte">Karte</a></li>
    <li><a href="#kontakt">Kontakt</a></li>
  </ul>
</nav>
<main class="container mx-auto p-4">
  <section id="zu-uns" class="scroll-mt-24">
    <h2>Willkommen in der Bar Uno</h2>
    <p>
      Eine für alles. Wir sind die Bar für alle Gelegenheiten im Herzen von
      München.
    </p>
    <p>
      Vom morgendlichen Kaffee mit Cornetto über den preiswerten Business-Lunch
      bis hin zum After-Work-Drink und dem entspannten Abend mit Longdrink und
      Pinsa. Unsere Gäste schätzen den persönlichen Service eines kleinen,
      ambitionierten Teams. Wir mögen, was wir tun und das merkt man.
    </p>
    <h3>
      <a href="https://www.instagram.com/barunomunich/">Mehr auf Instagram</a>
    </h3>
    <h3>Unsere Google Reviews</h3>
  </section>

  <section id="specials" class="scroll-mt-24">
    <h2>Daily Specials</h2>
  </section>

  <section id="karte" class="scroll-mt-24">
    <h2>Karte</h2>
  </section>
  <section id="kontakt" class="scroll-mt-24">
    <h2>Kontakt</h2>

    <p>E-Mail: <a href="mailto:info@bar-uno.de">info@bar-uno.de</a></p>

    <h3>Reservierung unter</h3>
    <p>Tel: <a href="tel:+498924206252">089 242 062 52</a></p>

    <h3>Öffnungszeiten</h3>
    <table class="border-separate border-spacing-y-1">
      <tbody
        ><tr class="border-b-2 border-black">
          <td class="font-bold pr-1 align-top">Montag bis Freitag</td>
          <td class="align-top">7:30 bis nach 24 Uhr</td>
        </tr>
        <tr class="border-b-2 border-black">
          <td class="font-bold pr-1 align-top">Samstags und an Feiertagen</td>
          <td class="align-top">17 bis nach 24 Uhr</td>
        </tr>
        <tr>
          <td class="font-bold pr-1 align-top">Sonntags</td>
          <td class="align-top">Geschlossen</td>
        </tr>
      </tbody>
    </table>
  </section>
</main>
<footer class="p-4 border-t-2 border-black space-y-4">
  <ul
    class="flex justify-center items-center gap-2 [&>li:not(:last-child)::after]:ms-2 [&>li:not(:last-child)::after]:content-['|']"
  >
    <li><a href="/impressum">Impressum</a></li>
    <li><a href="/datenschutz">Datenschutz</a></li>
  </ul>
  <p class="text-center">
    © BAR UNO, <span data-copyright-year>{year}</span>. All rights reserved.
  </p>
  <script is:inline>
    document.querySelectorAll("[data-copyright-year]").forEach((el) => {
      el.textContent = String(new Date().getFullYear());
    });
  </script>
</footer>
