---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import HeroImage from "../assets/bar-front.webp";
import UnoLogo from "../assets/uno-logo.svg";
import AllergenLinks from "./AllergenLinks.astro";
import PageMain from "./PageMain.astro";

const menu = await getEntry("daily-menu", "tageskarte");
if (!menu) {
	throw new Error("Missing content entry: daily-menu/tageskarte");
}

const googleReviews = await getEntry("google-reviews", "google-reviews");
if (!googleReviews) {
	throw new Error("Missing content entry: google-reviews/google-reviews");
}

function formatPrice(price: string) {
	return /^\d/.test(price) ? `${price} €` : price;
}

const mapsDirectionsUrl =
	"https://www.google.com/maps/dir/?api=1&destination=BAR+UNO%2C+Ludwigstra%C3%9Fe+11%2C+80539+M%C3%BCnchen";
const googleReviewsUrl =
	"https://www.google.com/maps/search/?api=1&query=BAR+UNO%2C+Ludwigstra%C3%9Fe+11%2C+80539+M%C3%BCnchen";
---

<header class="relative">
  <Image
    src={HeroImage}
    alt="Bar Uno Außenansicht"
    class="w-full h-auto block"
  />
  <h1>
    <span class="sr-only">Bar Uno</span><UnoLogo
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-1/3"
      aria-hidden="true"
    />
  </h1>
</header>
<slot />
<PageMain>
  <section id="zu-uns" class="scroll-mt-24">
    <h2>Willkommen in der Bar Uno</h2>
    <p>
      Eine für alles. Wir sind die Bar für alle Gelegenheiten 
      <a
        href={mapsDirectionsUrl}
        target="_blank"
        class="underline"
        rel="noopener noreferrer">im Herzen von München</a
      >.
    </p>
    <p>
      Vom morgendlichen Kaffee mit Cornetto über den preiswerten Business-Lunch
      bis hin zum After-Work-Drink und dem entspannten Abend mit Longdrink und
      Pinsa. Unsere Gäste schätzen den persönlichen Service eines kleinen,
      ambitionierten Teams. Wir mögen, was wir tun und das merkt man.
    </p>
    <h3>
      <a href="https://www.instagram.com/barunomunich/">Mehr auf Instagram</a>
    </h3>
    <h3>Unsere Google Reviews</h3>
    <p>
      <a
        href={googleReviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="underline">{googleReviews.data.ratingLabel}</a
      >
    </p>
    <ul class="mt-4 grid gap-4 sm:grid-cols-3">
      {
        googleReviews.data.items.map((review) => (
          <li class="border-2 border-black bg-white p-4 shadow-[4px_4px_0_0_#000]">
            <p
              class="m-0 tracking-widest text-amber-500"
              aria-label={`${review.stars} von 5 Sternen`}
            >
              {"★".repeat(review.stars)}
              <span class="text-amber-500/25">{"★".repeat(5 - review.stars)}</span>
            </p>
            <blockquote class="m-0 mt-2">
              <p class="m-0 text-sm leading-relaxed">„{review.text}“</p>
            </blockquote>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="specials" class="scroll-mt-24">
    <h2>Daily Specials</h2>
    <h3>{menu.data.title}</h3>
    <ul>
      {
        menu.data.items.map((item) => (
          <li style="margin-bottom: 1rem;">
            <strong>{item.name}</strong>
            {item.allergens && <AllergenLinks allergens={item.allergens} />}{" "}
            — {formatPrice(item.price)}
            {item.comment && (
              <p style="font-style: italic; margin: 0; color: #555;">
                {item.comment}
              </p>
            )}
          </li>
        ))
      }
    </ul>
    <a
      href="/karte"
      class="group mt-8 flex items-center justify-between gap-4 border-2 border-black bg-black px-5 py-4 text-white shadow-[6px_6px_0_0_#000] transition-colors hover:bg-white hover:text-black"
    >
      <span>
        <span class="block text-xl font-bold sm:text-2xl"
          >Zu unserer Abendkarte</span
        >
        <span
          class="inline-block text-sm text-white/75 transition-colors group-hover:text-black/70"
          >Speisen, Cocktails, Weine, Biere & mehr</span
        >
      </span>
      <span class="shrink-0 text-2xl" aria-hidden="true">→</span>
    </a>
  </section>

  <section id="kontakt" class="scroll-mt-24">
    <h2>Kontakt</h2>

    <p>E-Mail: <a href="mailto:info@bar-uno.de">info@bar-uno.de</a></p>
    <p>
      <a
        href={mapsDirectionsUrl}
        target="_blank"
        rel="noopener noreferrer"
        >Ludwigstraße 11, 80539 München</a
      >
    </p>

    <h3>Reservierung unter</h3>
    <p>Tel: <a href="tel:+498924206252">089 242 062 52</a></p>

    <h3>Öffnungszeiten</h3>
    <dl
      class="grid grid-cols-1 min-[420px]:grid-cols-[auto_1fr] min-[420px]:gap-x-6 min-[420px]:gap-y-1 sm:gap-x-8"
    >
      <dt class="font-bold">Montag bis Freitag</dt>
      <dd class="mb-3 last:mb-0 min-[420px]:mb-0">7:30 bis nach 24 Uhr</dd>
      <dt class="font-bold">Samstags und an Feiertagen</dt>
      <dd class="mb-3 last:mb-0 min-[420px]:mb-0">17 bis nach 24 Uhr</dd>
      <dt class="font-bold">Sonntags</dt>
      <dd class="mb-3 last:mb-0 min-[420px]:mb-0">Geschlossen</dd>
    </dl>
  </section>
</PageMain>
