---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultOgImage from "../assets/bar-front.webp";
import "../styles/global.css";

type Props = {
	title?: string;
	description?: string;
	ogImage?: ImageMetadata;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	noindex?: boolean;
};

const DEFAULT_TITLE = "Bar Uno - Bar & Bistro in München";
const DEFAULT_DESCRIPTION =
	"Bar Uno an der Ludwigstraße: Kaffee, Lunch, Cocktails und Speisen im Herzen von München. Persönlicher Service von morgens bis nach Mitternacht.";

const {
	title = DEFAULT_TITLE,
	description = DEFAULT_DESCRIPTION,
	ogImage = defaultOgImage,
	jsonLd,
	noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://www.bar-uno.de");
const canonicalURL = new URL(Astro.url.pathname, site);

const optimizedOg = await getImage({
	src: ogImage,
	width: 1200,
	height: 630,
	fit: "cover",
	format: "jpg",
});
const ogImageURL = new URL(optimizedOg.src, site);

const structuredData = jsonLd
	? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((item) =>
			item["@type"] === "BarOrPub" && !item.image
				? { ...item, image: [ogImageURL.href] }
				: item,
		)
	: undefined;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{
			noindex ? (
				<meta name="robots" content="noindex, follow" />
			) : (
				<link rel="canonical" href={canonicalURL} />
			)
		}

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:site_name" content="Bar Uno" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Bar Uno Außenansicht" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />

		{
			structuredData && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(structuredData)}
				/>
			)
		}
	</head>
	<body id="top" class="bg-background text-foreground">
		<slot />
	</body>
</html>

<style is:global>
	@layer base {
		html {
			height: 100%;
			/* TODO: Add dark mode support once I am happy with the design */
			color-scheme: light;
		}

		body {
			margin: 0;
			width: 100%;
			min-height: 100%;
			display: flex;
			flex-direction: column;
		}

		main h1 {
			font-size: clamp(1.75rem, 1.35rem + 1.8vw, 2.5rem);
			font-weight: 700;
			line-height: 1.25;
			letter-spacing: -0.025em;
			margin-block: 0 0.75rem;
		}

		h2 {
			font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem);
			font-weight: 700;
			line-height: 1.3;
			letter-spacing: -0.02em;
			margin-block: 2.5rem 0.625rem;
		}

		main > section:first-child h2 {
			margin-block-start: 0;
		}

		main > h1 + h2 {
			margin-block-start: 1.5rem;
		}

		h3 {
			font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem);
			font-weight: 600;
			line-height: 1.3;
			letter-spacing: -0.015em;
			margin-block: 1.5rem 0.5rem;
		}

		h2 + h3 {
			margin-block-start: 1rem;
		}

		p {
			margin: 0.5rem 0;
		}

		a {
			text-underline-offset: 2px;
			text-decoration: underline;
		}

		a:hover {
			text-decoration-style: dotted;
		}

		body > nav:first-of-type a,
		a.border-2.border-foreground {
			text-decoration: none;
		}

		body > nav:first-of-type a:hover,
		a.border-2.border-foreground:hover {
			text-decoration: none;
		}

		a:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: 2px;
		}
	}
</style>
